# Hlavicky pro Cloudflare Pages.
#
# Nahrazuje sekci "headers" z vercel.json. Syntax je jina: cesta na
# vlastnim radku, hlavicky odsazene pod ni. Zadne regulerni vyrazy —
# Pages umi jen prefixy a hvezdicku.
#
# CSP je identicka s puvodni. Firebase potrebuje gstatic.com,
# googleapis.com a frame-src pro prihlasovaci okno; bez nich se
# prihlaseni tise rozbije.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://www.gstatic.com https://*.googleapis.com https://*.firebaseio.com https://securetoken.googleapis.com https://identitytoolkit.googleapis.com wss://*.firebaseio.com; frame-src 'self' https://fpl-helper-a43a3.firebaseapp.com https://accounts.google.com; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'self' https://accounts.google.com; frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Skorapka appky se nesmi cachovat. Novy deploy musi byt videt hned,
# jinak lidem zustane stara verze i po aktualizaci.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Odznaky a znacky klubu se meni jednou za sezonu.
/club-marks.svg
  Cache-Control: public, max-age=604800

/assets/*
  Cache-Control: public, max-age=2592000, immutable
